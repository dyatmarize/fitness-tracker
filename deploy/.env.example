# Optional bearer token protecting the API (leave empty for no auth on LAN).
APP_TOKEN=

# Sync worker interval (Go duration).
SYNC_INTERVAL=1h

# COROS MCP endpoint. mcp.coros.com redirects to your account's regional
# server, which breaks the OAuth issuer check in the Go SDK — so set the
# regional URL directly. This account is US-region:
#   US: https://mcpus.coros.com/mcp   EU: https://mcpeu.coros.com/mcp   CN: https://mcpcn.coros.com/mcp
COROS_MCP_URL=https://mcpus.coros.com/mcp
